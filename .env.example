# Copy to .env on the server and use distinct, randomly generated credentials.
PONTO_S3_ACCESS=replace-with-generated-access-key
PONTO_S3_SECRET=replace-with-generated-secret
PONTO_S3_BUCKET=ponto
PONTO_DATA_DIR=/home/thiagohmm/.local/share/ponto
PONTO_OBJECT_DIR=/home/thiagohmm/.local/share/ponto-minio
PONTO_BACKUP_DIR=/home/thiagohmm/.local/share/ponto-backups
PONTO_EDGE_DIR=/home/thiagohmm/.local/share/ponto-edge
PONTO_BIND=0.0.0.0
PONTO_PORT=8090
PONTO_TZ=America/Sao_Paulo
PONTO_UPLOAD_MIB=20
# Web login (required on the server; leave unset only for local open tests).
PONTO_WEB_USER=replace-with-web-user
PONTO_WEB_PASSWORD=replace-with-strong-password
