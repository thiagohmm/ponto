# Copy to .env on the server and use distinct, randomly generated credentials.
PONTO_S3_ACCESS=replace-with-generated-access-key
PONTO_S3_SECRET=replace-with-generated-secret
PONTO_S3_BUCKET=ponto
# JDBC URL on marketing-postgres (role ponto, database ponto). Required by compose.
PONTO_DB_URL=jdbc:postgresql://marketing-postgres:5432/ponto?user=ponto&password=replace-with-generated-password
PONTO_DATA_DIR=/home/thiagohmm/.local/share/ponto
PONTO_OBJECT_DIR=/home/thiagohmm/.local/share/ponto-minio
PONTO_BACKUP_DIR=/home/thiagohmm/.local/share/ponto-backups
PONTO_EDGE_DIR=/home/thiagohmm/.local/share/ponto-edge
# Edge publishes :8090 (LAN→HTTPS redirect; localhost proxied) and :8443 (TLS).
PONTO_PORT=8090
PONTO_EDGE_BIND=0.0.0.0
PONTO_TZ=America/Sao_Paulo
PONTO_UPLOAD_MIB=20
# Web login (required on the server; leave unset only for local open tests).
PONTO_WEB_USER=replace-with-web-user
PONTO_WEB_PASSWORD=replace-with-strong-password

# There is deliberately no PONTO_VAULT_* here. The cofre's master password is typed by the
# owner in the browser or in the terminal, never stored here, in the database or in a log:
# the server only holds sealed blobs it cannot open, so a backup of this file does not
# unlock a single password — and a leaked .env cannot expose the cofre.
