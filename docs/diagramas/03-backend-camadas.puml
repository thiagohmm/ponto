@startuml backend-camadas
title Ponto — Camadas do backend (pontos/)

skinparam shadowing false
skinparam rectangle {
  BackgroundColor #FDFDFD
  BorderColor #333333
}
skinparam arrowColor #444444

rectangle "controller\nApp (menu CLI, v = cofre)\nWeb · Auth · VaultRoutes\nNoteRoutes · KanbanRoutes\nDiarioRoutes · AssistRoutes" as ctrl #E3F2FD

rectangle "app\nService (fachada) · VaultApp\nTimesheetApp · CompanyApp\nNotesApp · KanbanApp\nFilesApp · DiarioApp" as app #F3E5F5

rectangle "model\nEntry · Company · Note · Kanban*\nReport · BankRules · Holidays · Parse\nStr · Dur · Time · VaultCrypto\nVaultPayload · VaultGen · Minio" as model #FFF8E1

rectangle "infra\nDb · Migrations (v7)\nRepo · NotesStore · KanbanStore\nCompaniesStore · Diario\nVaultStore · Files · Minio · Assist" as infra #ECEFF1

rectangle "view\nIn (text, secret) · Out (CLI)\nJson · Csv · Xls · Pdf · Cols\nVaultFile (ponto-cofre/1)" as view #E8F5E9

rectangle "raiz ponto/\nMain · Ver · HealthCheck\nBad · NotFound · Conflict · VaultSealed\nNeedConfirm · StorageFailure\nProblema · Eof" as root #FBE9E7

database "PostgreSQL" as db
cloud "MinIO / S3" as s3

ctrl --> app : só fala com Service
app --> model
app --> infra
model ..> infra : Holidays usa CompanyApp (dias da empresa)
infra --> db : SQL + migrações v7
infra --> s3 : anexos
ctrl --> view : Json/Csv/Xls/Pdf
app ..> root : lança Bad/NeedConfirm/Conflict/VaultSealed

note as N1
  Regras de negócio puras ficam em model
  (BankRules, Holidays, Dur, Parse).
  Stores em infra montam o SQL.
  VaultStore só guarda blobs opaqueous:
  no cipher, no plaintext, no key.
  Controllers (e o menu CLI) nunca falam
  direto com os stores — sempre via Service.
end note
infra .. N1
@enduml
