@startuml frontend-navegacao
title Ponto — Navegação do frontend (web/src/App.tsx)

skinparam shadowing false
skinparam rectangle {
  BackgroundColor #FDFDFD
  BorderColor #333333
}

rectangle "AuthProvider" as auth #E8F5E9 {
}
rectangle "/login\nLoginPage" as login #FBE9E7
rectangle "RequireAuth\n(verifica GET /api/me)" as guard #FFF3E0

rectangle "Shell" as shell #E3F2FD {
  rectangle "sidebar\n8 abas (NavLink)" as nav
  rectangle "ConfirmProvider\nUnsavedProvider\nConnection" as ctx
  rectangle "CompanyProvider\n(empresa ativa por aba,\nsessionStorage)" as company #F3E5F5
  rectangle "CompanyBar\nseletor de empresa" as bar #F3E5F5
}

rectangle "Pages (Routes, key=companyId)\ncada aba é um chunk lazy" as pages #EDE7F6 {
  rectangle "/  Home" as r1
  rectangle "/novo  Form" as r2
  rectangle "/edit/:id  Form" as r3
  rectangle "/soma  Sum" as r4
  rectangle "/diario  Diario" as r5
  rectangle "/notas(/:id)  Notes" as r6
  rectangle "/kanban  Kanban" as r7
  rectangle "/exportar  Export" as r8
  rectangle "/config  Config" as r9
}

rectangle "PWA\nsw.js (produção)\nmanifest.webmanifest" as pwa #ECEFF1

auth --> login : /login
auth --> guard : qualquer outra rota
guard --> shell : logado
shell --> pages : <Suspense>
company --> pages : remonta as rotas\nquando troca a empresa
bar --> company
shell --> pwa : registra em produção

note bottom of company
  O companyId é acrescentado às URLs por api.ts
  (companyUrl). Cada aba do navegador lembra a
  própria empresa — sem mudar a preferência do terminal.
end note
@enduml
