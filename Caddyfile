{
	auto_https off
	admin off
	servers {
		protocols h1 h2
	}
}

# :8090 — LAN browsers on 192.168.0.8 go to HTTPS; 127.0.0.1 stays plain for smoke/ops.
:8090 {
	header -Server
	encode zstd gzip
	@lan host 192.168.0.8 192.168.0.8:8090
	redir @lan https://192.168.0.8:8443{uri} permanent
	reverse_proxy ponto:8080 {
		transport http {
			keepalive 60s
			keepalive_idle_conns 8
		}
	}
}

:8443 {
	header -Server
	header -Alt-Svc
	encode zstd gzip
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy ponto:8080 {
		transport http {
			keepalive 60s
			keepalive_idle_conns 8
		}
	}
}
